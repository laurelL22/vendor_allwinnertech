ifeq ($(CONFIG_DRIVERS_MSGBOX),y)

DRV_SOURCE_PATH=drivers$(DELIM)rtos-hal$(DELIM)hal$(DELIM)source
MSGBOX_PATH=drivers$(DELIM)rtos-hal$(DELIM)hal$(DELIM)source$(DELIM)msgbox

DEPPATH+=--dep-path $(MSGBOX_PATH)
VPATH+=:chip$(DELIM)$(MSGBOX_PATH)

ARCH_MSGBOX_SRC_PATH:=$(ARCH_SRC)$(DELIM)$(CONFIG_ARCH_CHIP)$(DELIM)$(MSGBOX_PATH)

CFLAGS += ${INCDIR_PREFIX}$(ARCH_MSGBOX_SRC_PATH)
CFLAGS += ${INCDIR_PREFIX}$(ARCH_MSGBOX_SRC_PATH)$(DELIM)platform

CHIP_CSRCS += $(MSGBOX_PATH)$(DELIM)msgbox_amp.c

endif
