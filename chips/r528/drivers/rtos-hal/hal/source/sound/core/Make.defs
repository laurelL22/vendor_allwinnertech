ifeq ($(CONFIG_SND_CORE_TINY),y)
# Include platform's table.
# Include build support

CORE_PATH=$(DRV_SOURCE_PATH)$(DELIM)sound$(DELIM)core

DEPPATH+=--dep-path $(CORE_PATH)
VPATH+=:chip$(DELIM)$(CORE_PATH)

# Include the  module.
CHIP_CSRCS += $(CORE_PATH)$(DELIM)snd_core.c
CHIP_CSRCS += $(CORE_PATH)$(DELIM)snd_dma.c
CHIP_CSRCS += $(CORE_PATH)$(DELIM)snd_pcm.c
CHIP_CSRCS += $(CORE_PATH)$(DELIM)snd_misc.c
CHIP_CSRCS += $(CORE_PATH)$(DELIM)snd_io.c
CHIP_CSRCS += $(CORE_PATH)$(DELIM)snd_ctl.c

endif

