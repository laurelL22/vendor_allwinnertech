ifeq ($(CONFIG_COMPONENTS_AW_TINY_ALSA_LIB),y)
# Include platform's table.
# Include build support
AW_TINY_ALSA_LIB_PATH=$(DRV_SOURCE_PATH)$(DELIM)sound$(DELIM)component$(DELIM)aw-tiny-alsa-lib

DEPPATH+=--dep-path $(AW_TINY_ALSA_LIB_PATH)
VPATH+=:chip$(DELIM)$(AW_TINY_ALSA_LIB_PATH)

# Include the  module.
ARCH_TINY_ALSA_LIB_SRC_PATH:=$(AW_SRCDIR)$(DELIM)$(AW_TINY_ALSA_LIB_PATH)
ARCH_TINY_ALSA_LIB_SOUND_PATH:=$(AW_SRCDIR)$(DELIM)drivers$(DELIM)rtos-hal$(DELIM)include$(DELIM)hal
CFLAGS += ${INCDIR_PREFIX}$(ARCH_TINY_ALSA_LIB_SRC_PATH)
CFLAGS += ${INCDIR_PREFIX}$(ARCH_TINY_ALSA_LIB_SOUND_PATH)

# Soundcards Register Select
CHIP_CSRCS += $(AW_TINY_ALSA_LIB_PATH)$(DELIM)pcm.c
CHIP_CSRCS += $(AW_TINY_ALSA_LIB_PATH)$(DELIM)control.c
CHIP_CSRCS += $(AW_TINY_ALSA_LIB_PATH)$(DELIM)pcm_config.c
CHIP_CSRCS += $(AW_TINY_ALSA_LIB_PATH)$(DELIM)pcm_hw.c
CHIP_CSRCS += $(AW_TINY_ALSA_LIB_PATH)$(DELIM)pcm_mmap.c

CHIP_CSRCS += $(AW_TINY_ALSA_LIB_PATH)$(DELIM)alsa_config.c


endif
