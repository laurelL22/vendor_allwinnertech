ifeq ($(CONFIG_DRIVERS_CCMU),y)
# Include platform's table.
# Include build support

DRV_SOURCE_PATH=drivers$(DELIM)rtos-hal$(DELIM)hal$(DELIM)source
CCMU_PATH=drivers$(DELIM)rtos-hal$(DELIM)hal$(DELIM)source$(DELIM)ccmu
SUNXI_NG_PATH=$(CCMU_PATH)$(DELIM)sunxi-ng

DEPPATH+=--dep-path $(CCMU_PATH) 
VPATH+=:chip$(DELIM)$(CCMU_PATH)

ARCH_CCMU_SRC_PATH:=$(AW_SRCDIR)$(DELIM)$(CCMU_PATH)
ARCH_CCMU_PARENT_SRC_PATH:=$(AW_SRCDIR)$(DELIM)$(DRV_SOURCE_PATH)

CFLAGS += ${INCDIR_PREFIX}$(ARCH_CCMU_SRC_PATH)
CFLAGS += ${INCDIR_PREFIX}$(ARCH_CCMU_PARENT_SRC_PATH)

