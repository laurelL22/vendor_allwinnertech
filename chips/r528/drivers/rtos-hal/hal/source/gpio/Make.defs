ifeq ($(CONFIG_DRIVERS_GPIO),y)
# Include platform's table.
# Include build support

DRV_SOURCE_PATH=drivers$(DELIM)rtos-hal$(DELIM)hal$(DELIM)source
GPIO_PATH=drivers$(DELIM)rtos-hal$(DELIM)hal$(DELIM)source$(DELIM)gpio

DEPPATH+=--dep-path $(GPIO_PATH) 
VPATH+=:chip$(DELIM)$(GPIO_PATH)

ARCH_GPIO_SRC_PATH:=$(ARCH_SRC)$(DELIM)chip$(DELIM)$(GPIO_PATH)

CFLAGS += ${INCDIR_PREFIX}$(ARCH_GPIO_SRC_PATH)
CFLAGS += ${INCDIR_PREFIX}$(ARCH_GPIO_SRC_PATH)$(DELIM)sun8iw20

# Include the  module.
CHIP_CSRCS += $(GPIO_PATH)$(DELIM)hal_gpio.c
CHIP_CSRCS += $(GPIO_PATH)$(DELIM)sun8iw20$(DELIM)gpio-sun8iw20.c

endif

