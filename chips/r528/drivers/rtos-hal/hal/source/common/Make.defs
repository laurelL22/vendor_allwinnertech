ifeq ($(CONFIG_DRIVERS_DMA),y)
# Include platform's table.
# Include build support

DRV_SOURCE_PATH=drivers$(DELIM)rtos-hal$(DELIM)hal$(DELIM)source
DMA_COMMON_PATH=drivers$(DELIM)rtos-hal$(DELIM)hal$(DELIM)source$(DELIM)common

DEPPATH+=--dep-path $(DMA_COMMON_PATH)
VPATH+=:chip$(DELIM)$(DMA_COMMON_PATH)

ARCH_SRC := $(TOPDIR)$(DELIM)arch$(DELIM)$(CONFIG_ARCH)$(DELIM)src
ARCH_INC := $(TOPDIR)$(DELIM)arch$(DELIM)$(CONFIG_ARCH)$(DELIM)include
ARCH_COMMON_SRC_PATH:=$(ARCH_SRC)$(DELIM)$(CONFIG_ARCH_CHIP)$(DELIM)$(DMA_COMMON_PATH)

# Include the  module.
CHIP_CSRCS += $(DMA_COMMON_PATH)$(DELIM)dma_alloc.c

endif

