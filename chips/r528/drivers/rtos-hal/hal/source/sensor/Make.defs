ifeq ($(CONFIG_SENSORS_HX3203), y)
DRV_SOURCE_PATH=drivers$(DELIM)rtos-hal$(DELIM)hal$(DELIM)source
HX3203_PATH=drivers$(DELIM)rtos-hal$(DELIM)hal$(DELIM)source$(DELIM)sensor

DEPPATH+=--dep-path $(HX3203_PATH) 
VPATH+=:chip$(DELIM)$(HX3203_PATH)

ARCH_GPIO_SRC_PATH:=$(ARCH_SRC)$(DELIM)chip$(DELIM)$(HX3203_PATH)

CFLAGS += ${INCDIR_PREFIX}$(ARCH_GPIO_SRC_PATH)
CFLAGS += ${INCDIR_PREFIX}$(ARCH_GPIO_SRC_PATH)$(DELIM)soc

CHIP_CSRCS += $(HX3203_PATH)$(DELIM)hx3203_uorb.c

endif
