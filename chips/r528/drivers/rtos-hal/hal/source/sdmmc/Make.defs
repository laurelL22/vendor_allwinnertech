ifeq ($(CONFIG_DRIVERS_SDMMC),y)
# Include platform's table.
# Include build support

DRV_SOURCE_PATH=drivers$(DELIM)rtos-hal$(DELIM)hal$(DELIM)source
SDMMC_PATH=drivers$(DELIM)rtos-hal$(DELIM)hal$(DELIM)source$(DELIM)sdmmc
SDMMC_INC_PATH=drivers$(DELIM)rtos-hal$(DELIM)include$(DELIM)hal$(DELIM)sdmmc

DEPPATH+=--dep-path $(SDMMC_PATH) 
VPATH+=:chip$(DELIM)$(SDMMC_PATH)

#SDMMC_CUR_SRC_PATH:=$(ARCH_SRC)$(DELIM)$(CONFIG_ARCH_CHIP)$(DELIM)$(SDMMC_PATH)
ARCH_SDMMC_SRC_PATH:=$(AW_SRCDIR)$(DELIM)$(SDMMC_INC_PATH)

CFLAGS += ${INCDIR_PREFIX}$(ARCH_SDMMC_SRC_PATH)
CFLAGS += ${INCDIR_PREFIX}$(ARCH_SDMMC_SRC_PATH)$(DELIM)hal
CFLAGS += ${INCDIR_PREFIX}$(ARCH_SDMMC_SRC_PATH)$(DELIM)sys
#CFLAGS += ${INCDIR_PREFIX}$(ARCH_SDMMC_SRC_PATH)$(DELIM)osal
CFLAGS += ${INCDIR_PREFIX}$(ARCH_SDMMC_SRC_PATH)$(DELIM)os

