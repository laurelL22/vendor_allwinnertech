ifeq ($(CONFIG_DRIVERS_USB),y)

DRV_SOURCE_PATH=drivers$(DELIM)rtos-hal$(DELIM)hal$(DELIM)source
USB_PATH=drivers$(DELIM)rtos-hal$(DELIM)hal$(DELIM)source$(DELIM)usb

DEPPATH+=--dep-path $(USB_PATH)
VPATH+=:chip$(DELIM)$(USB_PATH)

ARCH_USB_SRC_PATH:=$(ARCH_SRC)$(DELIM)chip$(DELIM)$(USB_PATH)

CFLAGS += ${INCDIR_PREFIX}$(ARCH_USB_SRC_PATH)
CFLAGS += ${INCDIR_PREFIX}$(ARCH_USB_SRC_PATH)$(DELIM)include
CFLAGS += ${INCDIR_PREFIX}$(ARCH_USB_SRC_PATH)$(DELIM)common
CFLAGS += ${INCDIR_PREFIX}$(ARCH_USB_SRC_PATH)$(DELIM)sun20iw1

