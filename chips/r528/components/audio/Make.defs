ifeq ($(CONFIG_AW_DRIVERS_AUDIO),y)
# Include Audio drivers support
AW_AUDIO_DRV_PATH=components$(DELIM)audio
AW_AUDIO_RPMSG_PATH=components$(DELIM)audio$(DELIM)include

AW_ALSA_UTILS_PATH=drivers$(DELIM)rtos-hal$(DELIM)hal$(DELIM)test$(DELIM)sound

DEPPATH+=--dep-path $(AW_AUDIO_DRV_PATH)
VPATH+=:chip$(DELIM)$(AW_AUDIO_DRV_PATH)

ARCH_AW_AUDIO_DRV_SRC_PATH:=$(AW_SRCDIR)$(DELIM)$(AW_AUDIO_DRV_PATH)
ARCH_ALSA_UTILS_SRC_PATH:=$(AW_SRCDIR)$(DELIM)$(AW_ALSA_UTILS_PATH)
ARCH_AUDIO_RPMSG_PATH:=$(AW_SRCDIR)$(DELIM)$(AW_AUDIO_RPMSG_PATH)

CFLAGS += ${INCDIR_PREFIX}$(ARCH_AW_AUDIO_DRV_SRC_PATH)
CFLAGS += ${INCDIR_PREFIX}$(AW_SRCDIR)$(DELIM)drivers$(DELIM)rtos-hal$(DELIM)include$(DELIM)hal
CFLAGS += ${INCDIR_PREFIX}$(ARCH_ALSA_UTILS_SRC_PATH)
CFLAGS += ${INCDIR_PREFIX}$(ARCH_AUDIO_RPMSG_PATH)
ifneq ($(CONFIG_AW_AUDIO_DMIC)$(CONFIG_AW_AUDIO_CODEC),)
CHIP_CSRCS += $(AW_AUDIO_DRV_PATH)$(DELIM)sunxi_alsa.c
endif

ifeq ($(CONFIG_AW_AUDIO_AUDIO_I2S),y)
CHIP_CSRCS += $(AW_AUDIO_DRV_PATH)$(DELIM)audio_i2s.c
endif

ifeq ($(CONFIG_AW_AUDIO_RPMSG_CTRL),y)
CHIP_CSRCS += $(AW_AUDIO_DRV_PATH)$(DELIM)sunxi_audio_rpmsg.c
endif

ifeq ($(CONFIG_AW_AUDIO_X4B_DRIVER),y)
CHIP_CSRCS += $(AW_AUDIO_DRV_PATH)$(DELIM)sunxi_x4b_alsa.c
endif

endif
