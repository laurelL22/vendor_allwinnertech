# The vector table is the "head" object, i.e., the one that must forced into
# the link in order to draw in all of the other components
include armv7-a/Make.defs

ifeq ($(CONFIG_ARCH_IDLE_CUSTOM),y)
CMN_CSRCS += r528_idle.c
endif

# r528-specific assembly language files

CHIP_ASRCS  =

# r528-specific C source files

CHIP_CSRCS  = r528_boot.c r528_serial.c r528_irq.c spare_head.c r528_lowputc.c secondary.c mi_boardctl.c mi_hw_version.c

ifeq ($(CONFIG_BOARD_USBDEV_SERIALSTR),y)
CHIP_CSRCS += mi_serialstr.c
endif

ifeq ($(CONFIG_SMP),y)
CHIP_CSRCS += r528_cpuboot.c
endif

ifeq ($(CONFIG_SCHED_TICKLESS),y)
ifneq ($(CONFIG_ONESHOT_AS_TICK),y)
CHIP_CSRCS += r528_tickless_timer.c
endif
endif

ifneq ($(CONFIG_SCHED_TICKLESS),y)
CHIP_CSRCS += r528_timerisr.c
endif

AW_SRCDIR = $(TOPDIR)$(DELIM)$(patsubst "%",%,$(CONFIG_ARCH_CHIP_CUSTOM_DIR))

ifeq ($(CONFIG_ARCH_TRUSTZONE_SECURE),y)
EXTRA_LIBPATHS += -L $(AW_SRCDIR)
EXTRA_LIBS += -lr528_secure
endif

CFLAGS += -include $(TOPDIR)$(DELIM)include$(DELIM)nuttx$(DELIM)config.h
CPPFLAGS += -include $(TOPDIR)$(DELIM)include$(DELIM)nuttx$(DELIM)config.h
CFLAGS += ${INCDIR_PREFIX}$(AW_SRCDIR)$(DELIM)internal_inc
CFLAGS += ${INCDIR_PREFIX}$(AW_SRCDIR)$(DELIM)hardware

CFLAGS += ${INCDIR_PREFIX}$(AW_SRCDIR)$(DELIM)..$(DELIM)..$(DELIM)..$(DELIM)xiaomi$(DELIM)mitee_iot$(DELIM)ca$(DELIM)triad
CFLAGS += ${INCDIR_PREFIX}$(AW_SRCDIR)$(DELIM)drivers$(DELIM)rtos-hal$(DELIM)include$(DELIM)osal
CFLAGS += ${INCDIR_PREFIX}$(AW_SRCDIR)$(DELIM)drivers$(DELIM)rtos-hal$(DELIM)include$(DELIM)hal
CFLAGS += ${INCDIR_PREFIX}$(AW_SRCDIR)$(DELIM)drivers$(DELIM)rtos-hal$(DELIM)hal$(DELIM)source
CFLAGS += ${INCDIR_PREFIX}$(AW_SRCDIR)$(DELIM)components$(DELIM)secure_storage
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)/../vendor/allwinnertech/chips/r528/drivers/rtos-hal/hal/source/hwspinlock
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)/../vendor/allwinnertech/chips/r528/drivers/rtos-hal/hal/source/timer
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)/arch/arm/include/armv7-a/

include $(AW_SRCDIR)$(DELIM)drivers$(DELIM)Make.defs
include $(AW_SRCDIR)$(DELIM)components$(DELIM)Make.defs
include $(AW_SRCDIR)$(DELIM)drv$(DELIM)Make.defs

ifeq ($(CONFIG_R528_WATCHDOG),y)
CHIP_CSRCS += r528_wdt.c
CHIP_CSRCS += sunxi_hal_wdt.c
endif

ifeq ($(CONFIG_R528_RESET),y)
CHIP_CSRCS += r528_reset.c
endif

ifeq ($(CONFIG_AW_RPTUN),y)
CHIP_CSRCS += dsp_boot.c
CHIP_CSRCS += r528_rptun.c
CHIP_CSRCS += r528_dsp_wdt.c
endif

ifeq ($(CONFIG_AW_RPTUN_SECURE),y)
CHIP_CSRCS += r528_rptun_secure.c
endif

ifeq ($(CONFIG_IEEE80211_REALTEK_WIFI),y)
CHIP_CSRCS += r528_wlan.c
endif

ifeq ($(CONFIG_R528_PROTECT_BROM),y)
CHIP_CSRCS += r528_watchpoint.c
endif

VPATH += $(ARCH_SRCDIR)
CHIP_CSRCS := $(patsubst %,chip/%,$(CHIP_CSRCS))
CHIP_ASRCS := $(patsubst %,chip/%,$(CHIP_ASRCS))
